# Database Configuration
POSTGRES_USER=unifiedcron
POSTGRES_PASSWORD=unifiedcron
POSTGRES_DB=unifiedcron
POSTGRES_PORT=5432

# API Configuration
API_PORT=3001
# Host interface the production compose file publishes the API port on. The default keeps it
# on loopback, because the reverse proxy reaches the API over the `proxy` Docker network and
# a directly reachable port makes TRUST_PROXY forgeable. Set 0.0.0.0 only if your proxy runs
# on another host, and restrict the port at the firewall if you do.
# API_BIND_ADDRESS=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# Number of reverse proxies in front of the API, or a list of trusted proxy
# addresses/subnets (for example 172.18.0.0/16, or loopback/linklocal/uniquelocal).
# This decides whether X-Forwarded-For is believed, which is what makes the per-address
# push ingest limit a per-client control instead of one shared cap for the route.
# Leave unset when the API is reached directly. Count only proxies you operate: each
# trusted hop is one X-Forwarded-For entry a client could otherwise forge.
# `TRUST_PROXY=true` is rejected at startup, because trusting every hop lets any client
# choose the address it is rate limited on. A hop count also assumes each trusted layer is
# the only route to the one behind it; see
# docs/DEPLOYMENT.md#reverse-proxy-and-client-addresses before setting it.
# With one reverse proxy, or with a CDN whose origin you have not confirmed is CDN-only, 1 is
# the value that is sound either way. Use 2 only once the origin accepts CDN traffic alone.
# TRUST_PROXY=1

# Web Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WORKER_PORT=3003

# Security
# Generate a 32-byte base64 key: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_32_bytes_key
JWT_SECRET=replace_me_with_32_bytes_key
NEXTAUTH_SECRET=replace_me_with_32_bytes_key

# Optional: External Database URL (overrides POSTGRES_* vars)
# DATABASE_URL=postgres://user:password@host:5432/database

# Optional: Environment
NODE_ENV=production
DISABLE_MONITORING=false
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
SUPABASE_ALLOW_CUSTOM_HOSTS=false
SUPABASE_ALLOW_PRIVATE_NETWORK=false

# Set to your public HTTPS API origin before installing Supabase push senders.
INGEST_PUBLIC_URL=https://api.example.com

# Optional: signed-push ingest rate limits, per minute, in memory, per API process.
# The per-connection cap is the per-sender control; the per-address cap is a coarse flood
# brake and is shared by every connection behind one address. Raise the per-connection cap
# only if a sender legitimately pushes more often than this.
# PUSH_RATE_LIMIT_PER_CONNECTION=60
# PUSH_RATE_LIMIT_PER_IP=3000
# Keys tracked per dimension. Reaching this bound evicts the oldest counter; it never
# rejects a push from a connection the table has not seen.
# PUSH_RATE_LIMIT_MAX_KEYS=20000
